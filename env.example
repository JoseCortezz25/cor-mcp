# Option 1: Client Credentials (recommended for CI/automation)
# Get your API key and secret from COR: Settings → Integrations → API
COR_API_KEY=your_api_key_here
COR_CLIENT_SECRET=your_client_secret_here

# Option 2: Leave unset and use the cor_login tool interactively
# COR_API_KEY=
# COR_CLIENT_SECRET=
